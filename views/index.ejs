<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neon Notes App</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(.95);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .modal-animation {
            animation: fadeIn .25s ease;
        }
    </style>

</head>

<body class="bg-[#171721] text-white min-h-screen px-4 py-8">

    <div class="max-w-6xl mx-auto">

        <!-- Heading -->

        <h1
            class="text-4xl sm:text-5xl font-extrabold text-center bg-gradient-to-r from-purple-400 to-fuchsia-500 bg-clip-text text-transparent mb-10">

            Neon Notes App

        </h1>

        <!-- Create Note -->

        <div
            class="bg-[#1d1d2b] rounded-2xl border border-purple-500/30 p-6 shadow-[0_0_30px_rgba(168,85,247,.25)]">

            <h2 class="text-2xl font-bold text-purple-400 mb-6">

                Create Note

            </h2>

            <form action="/create" method="POST">

                <input
                    type="text"
                    name="title"
                    placeholder="Enter Note Title..."
                    required
                    class="w-full mb-4 p-3 rounded-xl bg-[#11111a] border border-purple-500/30 outline-none focus:ring-2 focus:ring-purple-500 transition">

                <textarea
                    name="description"
                    rows="5"
                    placeholder="Write something..."
                    required
                    class="w-full mb-5 p-3 rounded-xl bg-[#11111a] border border-purple-500/30 outline-none focus:ring-2 focus:ring-purple-500 resize-none"></textarea>

                <button
                    class="w-full sm:w-auto px-7 py-3 rounded-xl bg-gradient-to-r from-purple-600 to-fuchsia-600 hover:scale-105 transition duration-300 shadow-lg shadow-purple-600/30">

                    Create Note

                </button>

            </form>

        </div>

        <!-- Notes -->

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">

            <% if(files.length===0){ %>

                <div
                    class="col-span-full text-center border border-dashed border-purple-500/40 rounded-2xl p-10 bg-[#1d1d2b]">

                    <i class="fa-regular fa-note-sticky text-5xl text-purple-400 mb-5"></i>

                    <h2 class="text-2xl font-bold text-purple-400">

                        No Notes Yet

                    </h2>

                    <p class="text-gray-400 mt-3">

                        Create your first note to get started.

                    </p>

                </div>

            <% } else { %>

                <% files.forEach(function(file){ %>

                    <div
                        class="bg-[#1d1d2b] rounded-2xl border border-purple-500/20 p-5 hover:-translate-y-1 transition duration-300 shadow-lg hover:shadow-purple-500/30">

                        <div class="flex justify-between items-start gap-3">

                            <h2 class="text-xl font-bold text-purple-400 break-words">

                                <%= file.title %>

                            </h2>

                            <form
                                action="/delete/<%= file.filename %>"
                                method="POST"
                                class="delete-form">

                                <button
                                    class="w-9 h-9 rounded-lg border border-red-500/30 hover:bg-red-500/20 text-red-400 transition flex items-center justify-center">

                                    <i class="fa-solid fa-trash"></i>

                                </button>

                            </form>

                        </div>

                        <p
                            class="text-gray-300 text-sm leading-6 mt-4 overflow-hidden"
                            style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;">

                            <%= file.description %>

                        </p>

                        <div class="mt-6 flex justify-between items-center">

                            <a
                                href="/files/<%= file.filename %>"
                                class="text-sm px-4 py-2 rounded-lg border border-purple-500/40 hover:bg-purple-600 transition">

                                Read More

                            </a>

                            <span class="text-xs text-gray-500">

                                Keep Learning 🚀

                            </span>

                        </div>

                    </div>

                <% }); %>

            <% } %>

        </div>

    </div>
 <!-- Delete Modal -->
    <div id="deleteModal"
        class="fixed inset-0 hidden items-center justify-center bg-black/70 backdrop-blur-sm z-50 px-4">

        <div
            class="modal-animation w-full max-w-md bg-[#1d1d2b] rounded-2xl border border-purple-500/30 p-7 shadow-[0_0_35px_rgba(168,85,247,.35)]">

            <div class="flex justify-center">

                <div
                    class="w-16 h-16 rounded-full bg-red-500/10 border border-red-500/30 flex items-center justify-center">

                    <i class="fa-solid fa-trash text-red-500 text-2xl"></i>

                </div>

            </div>

            <h2 class="text-2xl font-bold text-center mt-6">

                Delete Note?

            </h2>

            <p class="text-gray-400 text-center mt-3 leading-7">

                This note will be permanently deleted and cannot be recovered.

            </p>

            <div class="grid grid-cols-2 gap-3 mt-8">

                <button
                    id="cancelDelete"
                    class="py-3 rounded-xl bg-[#2a2a3a] hover:bg-[#34344b] transition">

                    Cancel

                </button>

                <button
                    id="confirmDelete"
                    class="py-3 rounded-xl bg-gradient-to-r from-red-600 to-red-500 hover:scale-105 transition shadow-lg shadow-red-500/30">

                    Delete

                </button>

            </div>

        </div>

    </div>

    <script>

        const modal = document.getElementById("deleteModal");
        const confirmBtn = document.getElementById("confirmDelete");
        const cancelBtn = document.getElementById("cancelDelete");

        let currentForm = null;

        document.querySelectorAll(".delete-form").forEach(form => {

            form.addEventListener("submit", function (e) {

                e.preventDefault();

                currentForm = this;

                modal.classList.remove("hidden");
                modal.classList.add("flex");

            });

        });

        cancelBtn.addEventListener("click", () => {

            modal.classList.remove("flex");
            modal.classList.add("hidden");

        });

        confirmBtn.addEventListener("click", () => {

            currentForm.submit();

        });

        modal.addEventListener("click", function (e) {

            if (e.target === modal) {

                modal.classList.remove("flex");
                modal.classList.add("hidden");

            }

        });

    </script>

</body>

</html>