<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Neon Notes</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>

        body{
            background:#14141d;
            background-image:
            radial-gradient(circle at top left,#6d28d920,transparent 40%),
            radial-gradient(circle at bottom right,#9333ea20,transparent 40%);
        }

        ::-webkit-scrollbar{
            width:8px;
        }

        ::-webkit-scrollbar-thumb{
            background:#7c3aed;
            border-radius:20px;
        }

        ::-webkit-scrollbar-track{
            background:#171721;
        }

    </style>

</head>

<body class="text-white">

<div class="max-w-7xl mx-auto px-4 sm:px-8 py-10">

    <!-- Heading -->

    <div class="text-center">

        <h1
        class="text-4xl md:text-6xl font-extrabold bg-gradient-to-r from-fuchsia-400 via-purple-500 to-violet-400 bg-clip-text text-transparent">

            Neon Notes

        </h1>

        <p class="text-gray-400 mt-3">

            Store your thoughts beautifully ✨

        </p>

    </div>


    <!-- Stats -->

    <div
    class="flex flex-col sm:flex-row justify-center gap-4 mt-8">

        <div
        class="bg-[#1c1c29] border border-purple-500/30 rounded-xl px-6 py-4">

            <p class="text-sm text-gray-400">

                Total Notes

            </p>

            <h2 class="text-2xl font-bold text-purple-400">

                <%= files.length %>

            </h2>

        </div>

        <div
        class="bg-[#1c1c29] border border-purple-500/30 rounded-xl px-6 py-4">

            <p class="text-sm text-gray-400">

                Status

            </p>

            <h2 class="text-green-400 font-semibold">

                Active

            </h2>

        </div>

    </div>



    <!-- Create Form -->

    <div
    class="mt-10 bg-[#1a1a27] border border-purple-500/30 rounded-3xl p-6 shadow-[0_0_40px_rgba(168,85,247,.2)]">

        <h2
        class="text-2xl font-bold text-purple-400 mb-6">

            Create Note

        </h2>

        <form
        action="/create"
        method="POST">

            <input

            required

            type="text"

            name="title"

            placeholder="Enter note title..."

            class="w-full bg-[#101018] border border-purple-500/30 rounded-xl p-4 outline-none focus:border-purple-500 transition">

            <textarea

            required

            name="description"

            rows="6"

            placeholder="Write your thoughts..."

            class="w-full bg-[#101018] border border-purple-500/30 rounded-xl p-4 outline-none focus:border-purple-500 transition resize-none mt-5"></textarea>

            <button

            class="mt-5 w-full sm:w-auto bg-gradient-to-r from-purple-600 to-fuchsia-600 hover:scale-105 transition px-7 py-3 rounded-xl font-semibold shadow-lg shadow-purple-700/30">

                <i class="fa-solid fa-plus mr-2"></i>

                Create Note

            </button>

        </form>

    </div>



    <!-- Notes -->

    <div
    class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6 mt-10">
    <% if(files.length===0){ %>

<div
class="col-span-full bg-[#1a1a27] border border-dashed border-purple-500/30 rounded-3xl p-12 text-center">

    <div
    class="w-24 h-24 mx-auto rounded-full bg-purple-500/10 flex items-center justify-center">

        <i class="fa-regular fa-note-sticky text-5xl text-purple-400"></i>

    </div>

    <h2
    class="text-3xl font-bold mt-6 text-purple-400">

        No Notes Yet

    </h2>

    <p
    class="text-gray-400 mt-3">

        Create your first note and start organizing your ideas.

    </p>

</div>

<% } else { %>

<% files.forEach(function(file){ %>

<div
class="group bg-[#1b1b29] border border-purple-500/20 rounded-3xl p-5 transition duration-300 hover:-translate-y-2 hover:border-purple-500/60 hover:shadow-[0_0_35px_rgba(168,85,247,.25)]">

    <!-- Title -->

    <div
    class="flex justify-between items-start gap-3">

        <h2
        class="text-xl font-bold text-purple-400 break-words">

            <%= file.title %>

        </h2>

        <form
        action="/delete/<%= file.filename %>"
        method="POST"
        class="delete-form">

            <button

            type="submit"

            class="w-10 h-10 rounded-xl border border-red-500/30 hover:bg-red-500/20 text-red-400 transition duration-300">

                <i class="fa-solid fa-trash"></i>

            </button>

        </form>

    </div>


    <!-- Description -->

    <p

    class="text-gray-300 text-sm leading-7 mt-5 overflow-hidden"

    style="display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;">

        <%= file.description %>

    </p>


    <!-- Footer -->

    <div
    class="flex justify-between items-center mt-7">

        <a

        href="/files/<%= file.filename %>"

        class="inline-flex items-center gap-2 text-sm bg-gradient-to-r from-purple-600 to-fuchsia-600 px-4 py-2 rounded-xl hover:scale-105 transition">

            Read More

            <i class="fa-solid fa-arrow-right"></i>

        </a>

        <span
        class="text-xs text-gray-500">

            Keep Learning 🚀

        </span>

    </div>

</div>

<% }) %>

<% } %>

</div>

</div>
<!-- Premium Delete Modal -->

<div
id="deleteModal"
class="fixed inset-0 hidden items-center justify-center bg-black/70 backdrop-blur-md z-50 px-4">

    <div
    class="w-full max-w-md bg-[#1b1b29] border border-purple-500/30 rounded-3xl p-8 shadow-[0_0_50px_rgba(168,85,247,.35)] animate-[fadeIn_.25s_ease]">

        <!-- Icon -->

        <div class="flex justify-center">

            <div
            class="w-20 h-20 rounded-full bg-red-500/10 border border-red-500/30 flex items-center justify-center">

                <i
                class="fa-solid fa-trash text-3xl text-red-500"></i>

            </div>

        </div>

        <!-- Heading -->

        <h2
        class="text-3xl font-bold text-center mt-6">

            Delete Note?

        </h2>

        <!-- Text -->

        <p
        class="text-center text-gray-400 leading-7 mt-4">

            This action is permanent.

            Once deleted, this note cannot be recovered again.

        </p>

        <!-- Buttons -->

        <div
        class="grid grid-cols-2 gap-4 mt-8">

            <button

            id="cancelDelete"

            class="py-3 rounded-xl border border-gray-600 bg-[#252535] hover:bg-[#303045] transition">

                <i class="fa-solid fa-xmark mr-2"></i>

                Cancel

            </button>

            <button

            id="confirmDelete"

            class="py-3 rounded-xl bg-gradient-to-r from-red-600 to-red-500 hover:scale-105 transition shadow-lg shadow-red-600/30">

                <i class="fa-solid fa-trash mr-2"></i>

                Delete

            </button>

        </div>

    </div>

</div>
<!-- Footer -->

<footer class="mt-14 pb-8 text-center">

    <div class="border-t border-purple-500/20 pt-6">

        <p class="text-gray-500 text-sm">

            Built with ❤️ using
            <span class="text-purple-400">Node.js</span>,
            <span class="text-purple-400">Express.js</span> &
            <span class="text-purple-400">EJS</span>

        </p>

    </div>

</footer>

<script>

const modal = document.getElementById("deleteModal");
const confirmBtn = document.getElementById("confirmDelete");
const cancelBtn = document.getElementById("cancelDelete");

let currentForm = null;

document.querySelectorAll(".delete-form").forEach(form=>{

    form.addEventListener("submit",function(e){

        e.preventDefault();

        currentForm=this;

        modal.classList.remove("hidden");
        modal.classList.add("flex");

        document.body.style.overflow="hidden";

    });

});

function closeModal(){

    modal.classList.remove("flex");
    modal.classList.add("hidden");

    document.body.style.overflow="auto";

}

cancelBtn.addEventListener("click",closeModal);

confirmBtn.addEventListener("click",()=>{

    if(currentForm){

        currentForm.submit();

    }

});

modal.addEventListener("click",(e)=>{

    if(e.target===modal){

        closeModal();

    }

});

document.addEventListener("keydown",(e)=>{

    if(e.key==="Escape"){

        closeModal();

    }

});

</script>

</body>

</html>