<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Neon Notes App</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
</head>

<body class="bg-[#0a0a0f] text-white min-h-screen flex flex-col items-center p-10">

    <h1 class="text-4xl font-bold mb-10 text-purple-400">
        Neon Notes App
    </h1>

    <div class="w-full max-w-3xl">
        <!-- Create Note -->
        <div class ="bg-[#11111a] border border-purple-500/30 rounded-2xl p-6 shadow-[0_0_20px_rgba(168,85,247,0.3)]">

            <h1 class="text-2xl font-bold mb-4 text-purple-400">
                Create Note
            </h1>

            <form action="/create" method="POST">

                <input
                    type="text"
                    name="title"
                    placeholder="Title"
                    class="w-full mb-4 p-3 rounded-lg bg-[#0a0a0f] border border-purple-500/30 focus:outline-none focus:border-purple-500">

                <textarea
                    name="description"
                    rows="4"
                    placeholder="Description"
                    class="w-full mb-4 p-3 rounded-lg bg-[#0a0a0f] border border-purple-500/30 focus:outline-none focus:border-purple-500"></textarea>

                <input
                    type="submit"
                    value="Create Note"
                    class="bg-purple-600 hover:bg-purple-700 px-6 py-2 rounded-lg transition">

            </form>

        </div>
        <!-- Notes -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">

            <% if(files.length===0){ %>

                <div class="col-span-full text-center border border-dashed border-purple-500/30 rounded-xl p-10">

                    <h2 class="text-xl text-purple-400">
                        No Tasks Yet 💜
                    </h2>

                    <p class="text-gray-400 mt-2">
                        Start by creating your first note.
                    </p>

                </div>

            <% } else { %>

                <% files.forEach(function(file){ %>

                    <div class="bg-[#11111a] p-4 rounded-xl border border-purple-500/20 shadow-[0_0_10px_rgba(168,85,247,0.2)] hover:shadow-[0_0_20px_rgba(168,85,247,0.5)] transition">

                        <div class="flex justify-between mb-3 gap-6">
                            <h1 class="text-xl font-semibold text-purple-400 break-words">
                                <%= file.title %>
                            </h1>
                          
                        </div>
                        <!-- Title + Delete -->
                       

                        <!-- Description -->
                        <p
                            class="text-gray-300 text-xs overflow-hidden"
                            style="display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;">
                            <%= file.description %>
                        </p>
                         <div class="flex justify-between items-center">
                            <!-- Read More -->
                        <a
                            href="/files/<%= file.filename %>"
                            class="inline-block mt-4 px-2 py-2 text-xs border border-purple-500/50 hover:bg-purple-700 rounded-lg transition">
                            Read More...
                        </a>
                        <form action="/delete/<%= file.filename %>" method="POST" class="delete-form">
                                <button
                                    type="submit"
                                    class="w-8 h-8 mt-5  flex items-center justify-center border border-red-500/30 rounded-md text-gray-400 hover:bg-red-500/20 hover:text-red-500 transition">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                        </form>



                        </div>
                        
                    </div>
                <% }); %>
                   
            <% } %>
        
        </div>
        
    </div>
<!-- Delete Modal -->
    <div id="deleteModal"
        class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50">

        <div
            class="w-[420px] bg-[#11111a] border border-purple-500/30 rounded-2xl p-7 shadow-[0_0_35px_rgba(168,85,247,0.35)] animate-[fadeIn_.25s_ease]">

            <div class="flex justify-center">
                <div
                    class="w-16 h-16 rounded-full bg-red-500/10 border border-red-500/30 flex items-center justify-center">
                    <i class="fa-solid fa-trash text-red-500 text-2xl"></i>
                </div>
            </div>

            <h2 class="text-2xl font-bold text-center mt-5">
                Delete Note?
            </h2>

            <p class="text-gray-400 text-center mt-3 leading-7">
                This action is permanent. Once deleted, this note cannot be recovered.
            </p>

            <div class="flex gap-3 mt-8">

                <button id="cancelDelete"
                    class="flex-1 py-3 rounded-xl bg-[#1b1b27] hover:bg-[#27273a] transition">
                    Cancel
                </button>

                <button id="confirmDelete"
                    class="flex-1 py-3 rounded-xl bg-red-600 hover:bg-red-700 transition shadow-[0_0_18px_rgba(239,68,68,.45)]">
                    Delete
                </button>

            </div>

        </div>

    </div>
    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
    const modal = document.getElementById("deleteModal");
    const confirmBtn = document.getElementById("confirmDelete");
    const cancelBtn = document.getElementById("cancelDelete");

    let currentForm = null;

    document.querySelectorAll(".delete-form").forEach(form => {

        form.addEventListener("submit", function (e) {

            e.preventDefault();

            currentForm = form;

            modal.classList.remove("hidden");
            modal.classList.add("flex");

        });

    });

    cancelBtn.addEventListener("click", () => {

        modal.classList.remove("flex");
        modal.classList.add("hidden");

    });

    confirmBtn.addEventListener("click", () => {

        currentForm.submit();

    });

    modal.addEventListener("click", (e) => {

        if (e.target === modal) {

            modal.classList.remove("flex");
            modal.classList.add("hidden");

        }

    });
    </script>

</body>
</html>