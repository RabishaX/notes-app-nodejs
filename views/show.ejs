<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= file.title %> | Neon Notes</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <style>

        body{
            background:#14141d;
            background-image:
            radial-gradient(circle at top left,#6d28d920,transparent 40%),
            radial-gradient(circle at bottom right,#9333ea20,transparent 40%);
        }

        ::-webkit-scrollbar{
            width:8px;
        }

        ::-webkit-scrollbar-thumb{
            background:#7c3aed;
            border-radius:20px;
        }

        ::-webkit-scrollbar-track{
            background:#171721;
        }

    </style>

</head>

<body class="text-white min-h-screen px-4 py-10">

<div class="max-w-5xl mx-auto">

    <!-- Heading -->

    <div class="text-center mb-10">

        <h1
        class="text-4xl md:text-5xl font-extrabold bg-gradient-to-r from-fuchsia-400 via-purple-500 to-violet-400 bg-clip-text text-transparent">

            Neon Notes

        </h1>

        <p class="text-gray-400 mt-2">

            Read your saved note

        </p>

    </div>

    <!-- Note Card -->

    <div
    class="bg-[#1a1a27] border border-purple-500/30 rounded-3xl p-6 md:p-8 shadow-[0_0_40px_rgba(168,85,247,.25)]">

        <!-- Header -->

        <div class="flex justify-between items-start gap-5">

            <div class="flex-1">

                <p
                class="uppercase tracking-[0.3em] text-xs text-purple-400 mb-3">

                    NOTE DETAILS

                </p>

                <h1
                class="text-3xl md:text-5xl font-bold break-words leading-tight">

                    <%= file.title %>

                </h1>

            </div>

            <form
            action="/delete/<%= file.filename %>"
            method="POST"
            class="delete-form">

                <button

                type="submit"

                class="w-12 h-12 rounded-xl border border-red-500/30 bg-red-500/10 text-red-400 hover:bg-red-600 hover:text-white hover:scale-110 transition duration-300">

                    <i class="fa-solid fa-trash"></i>

                </button>

            </form>

        </div>

        <!-- Description -->

        <div
        class="mt-8 bg-[#11111a] border border-purple-500/20 rounded-2xl p-6 max-h-[450px] overflow-y-auto">

            <p
            class="text-gray-300 leading-8 whitespace-pre-wrap text-justify">

                <%= file.description %>

            </p>

        </div>

        <!-- Footer -->

        <div
        class="mt-8 border-t border-purple-500/20 pt-6 flex flex-col sm:flex-row gap-4 sm:justify-between sm:items-center">

            <span class="text-gray-500">

                Keep Learning 🚀

            </span>

            <a

            href="/"

            class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-purple-600 to-fuchsia-600 px-6 py-3 rounded-xl hover:scale-105 transition duration-300 shadow-lg shadow-purple-700/30">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Notes

            </a>

        </div>

    </div>

</div>
<!-- Delete Modal -->

<div
id="deleteModal"
class="fixed inset-0 hidden items-center justify-center bg-black/70 backdrop-blur-md z-50 px-4">

    <div
    class="w-full max-w-md bg-[#1b1b29] border border-purple-500/30 rounded-3xl p-8 shadow-[0_0_50px_rgba(168,85,247,.35)]">

        <div class="flex justify-center">

            <div
            class="w-20 h-20 rounded-full bg-red-500/10 border border-red-500/30 flex items-center justify-center">

                <i class="fa-solid fa-trash text-red-500 text-3xl"></i>

            </div>

        </div>

        <h2
        class="text-3xl font-bold text-center mt-6">

            Delete Note?

        </h2>

        <p
        class="text-gray-400 text-center mt-4 leading-7">

            This action is permanent.
            Once deleted, this note cannot be recovered.

        </p>

        <div class="grid grid-cols-2 gap-4 mt-8">

            <button

            id="cancelDelete"

            class="py-3 rounded-xl bg-[#252535] hover:bg-[#303045] transition">

                <i class="fa-solid fa-xmark mr-2"></i>

                Cancel

            </button>

            <button

            id="confirmDelete"

            class="py-3 rounded-xl bg-gradient-to-r from-red-600 to-red-500 hover:scale-105 transition shadow-lg shadow-red-600/30">

                <i class="fa-solid fa-trash mr-2"></i>

                Delete

            </button>

        </div>

    </div>

</div>

<script>

const modal=document.getElementById("deleteModal");
const confirmBtn=document.getElementById("confirmDelete");
const cancelBtn=document.getElementById("cancelDelete");

let currentForm=null;

document.querySelectorAll(".delete-form").forEach(form=>{

    form.addEventListener("submit",function(e){

        e.preventDefault();

        currentForm=this;

        modal.classList.remove("hidden");
        modal.classList.add("flex");

        document.body.style.overflow="hidden";

    });

});

function closeModal(){

    modal.classList.remove("flex");
    modal.classList.add("hidden");

    document.body.style.overflow="auto";

}

cancelBtn.addEventListener("click",closeModal);

confirmBtn.addEventListener("click",()=>{

    if(currentForm){

        currentForm.submit();

    }

});

modal.addEventListener("click",(e)=>{

    if(e.target===modal){

        closeModal();

    }

});

document.addEventListener("keydown",(e)=>{

    if(e.key==="Escape"){

        closeModal();

    }

});

</script>

</body>

</html>