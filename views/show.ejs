<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>View Note</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>

  <body
    class="bg-[#0a0a0f] text-white min-h-screen flex items-center justify-center p-8"
  >
    <div class="w-full max-w-3xl">
      <!-- Note Card -->
      <div
        class="bg-[#11111a] border border-purple-500/30 rounded-2xl p-8 shadow-[0_0_25px_rgba(168,85,247,0.3)]"
      >
        <div class="flex justify-between items-start gap-6">
          <div class="flex-1">
            <p class="text-xs uppercase tracking-[0.2em] text-purple-400 mb-2">
              Note Details
            </p>

            <h1 class="text-4xl font-bold text-white leading-tight break-words">
              <%= file.title %>
            </h1>
          </div>

          <form action="/delete/<%= file.filename %>" method="POST" class="delete-form">
            <button
              class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/30 flex items-center justify-center text-red-400 hover:bg-red-600 hover:text-white hover:scale-105 transition-all duration-200"
            >
              <i class="fa-solid fa-trash"></i>
            </button>
          </form>
        </div>
        <div
          class="mt-6 bg-[#0a0a0f] border border-purple-500/20 rounded-xl p-6"
        >
          <p class="text-gray-300 leading-7 whitespace-pre-wrap text-justify">
            <%= file.description %>
          </p>
        </div>
        <!-- Footer -->
        <div
          class="mt-8 flex items-center justify-between border-t border-purple-500/20 pt-6"
        >
          <span class="text-gray-500 text-sm"> Keep Learning 🚀 </span>

          <a
            href="/"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 transition shadow-[0_0_15px_rgba(168,85,247,0.5)]"
          >
            <i class="fa-solid fa-arrow-left-long"></i>
            <span>Back to Notes</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Delete Modal -->
    <div id="deleteModal"
        class="fixed inset-0 bg-black/70 backdrop-blur-sm hidden items-center justify-center z-50">

        <div
            class="w-[420px] bg-[#11111a] border border-purple-500/30 rounded-2xl p-7 shadow-[0_0_35px_rgba(168,85,247,0.35)] animate-[fadeIn_.25s_ease]">

            <div class="flex justify-center">
                <div
                    class="w-16 h-16 rounded-full bg-red-500/10 border border-red-500/30 flex items-center justify-center">
                    <i class="fa-solid fa-trash text-red-500 text-2xl"></i>
                </div>
            </div>

            <h2 class="text-2xl font-bold text-center mt-5">
                Delete Note?
            </h2>

            <p class="text-gray-400 text-center mt-3 leading-7">
                This action is permanent. Once deleted, this note cannot be recovered.
            </p>

            <div class="flex gap-3 mt-8">

                <button id="cancelDelete"
                    class="flex-1 py-3 rounded-xl bg-[#1b1b27] hover:bg-[#27273a] transition">
                    Cancel
                </button>

                <button id="confirmDelete"
                    class="flex-1 py-3 rounded-xl bg-red-600 hover:bg-red-700 transition shadow-[0_0_18px_rgba(239,68,68,.45)]">
                    Delete
                </button>

            </div>

        </div>

    </div>
    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
    const modal = document.getElementById("deleteModal");
    const confirmBtn = document.getElementById("confirmDelete");
    const cancelBtn = document.getElementById("cancelDelete");

    let currentForm = null;

    document.querySelectorAll(".delete-form").forEach(form => {

        form.addEventListener("submit", function (e) {

            e.preventDefault();

            currentForm = form;

            modal.classList.remove("hidden");
            modal.classList.add("flex");

        });

    });

    cancelBtn.addEventListener("click", () => {

        modal.classList.remove("flex");
        modal.classList.add("hidden");

    });

    confirmBtn.addEventListener("click", () => {

        currentForm.submit();

    });

    modal.addEventListener("click", (e) => {

        if (e.target === modal) {

            modal.classList.remove("flex");
            modal.classList.add("hidden");

        }

    });
    </script>

  </body>
</html>
